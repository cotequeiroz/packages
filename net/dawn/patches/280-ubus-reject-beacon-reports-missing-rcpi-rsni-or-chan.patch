From 4d994a03dedeb64545b3c1ecf60618d2604eb6a1 Mon Sep 17 00:00:00 2001
From: Ut0pia Yu <14101589+Jefferyu@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:25:54 +0800
Subject: [PATCH 2/2] ubus: reject beacon reports missing rcpi, rsni, or
 channel

A refused 802.11k beacon report has no measurement body. parse_to_beacon_rep()
then passed NULL attributes to blobmsg_get_u16() and crashed with SIGSEGV.

Fixes #279

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 src/utils/ubus.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/utils/ubus.c b/src/utils/ubus.c
index 8e7b679..63e6cd2 100644
--- a/src/utils/ubus.c
+++ b/src/utils/ubus.c
@@ -342,6 +342,11 @@ static probe_entry* parse_to_beacon_rep(struct blob_attr *msg) {
 
     if (!tb[BEACON_REP_BSSID] ||
         !tb[BEACON_REP_ADDR] ||
+        /* Refused/incapable measurements may have no measurement body.
+         * Validate every field below before using blobmsg_get_u16(). */
+        !tb[BEACON_REP_RCPI] ||
+        !tb[BEACON_REP_RSNI] ||
+        !tb[BEACON_REP_CHANNEL] ||
         hwaddr_aton(blobmsg_data(tb[BEACON_REP_BSSID]), msg_bssid.u8) ||
         hwaddr_aton(blobmsg_data(tb[BEACON_REP_ADDR]), msg_client.u8))
     {
