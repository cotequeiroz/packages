From 269ab8601e1b71c35c0c6270fc6f3d17c28dac89 Mon Sep 17 00:00:00 2001
From: Feng Cheng <i@pfeng.top>
Date: Mon, 14 Sep 2026 10:32:29 +0800
Subject: [PATCH 1/2] fix: only return true when hostapd_dir is actually
 configured

Previously uci_get_dawn_hostapd_dir() returned true as long as a
hostapd section was found, even if hostapd_dir was not configured.
Now it only returns true and copies the value when hostapd_dir is
explicitly set; otherwise it falls back to the default path and
returns false to indicate no custom configuration was found.
---
 src/utils/dawn_uci.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/utils/dawn_uci.c b/src/utils/dawn_uci.c
index 23f6ce7..55130e3 100644
--- a/src/utils/dawn_uci.c
+++ b/src/utils/dawn_uci.c
@@ -455,10 +455,10 @@ bool uci_get_dawn_hostapd_dir() {
         if (strcmp(s->type, "hostapd") == 0) {
             // CONFIG-H: hostapd_dir|Path to hostapd runtime information|[/var/run/hostapd]
             const char* str = uci_lookup_option_string(uci_ctx, s, "hostapd_dir");
-            if (str)
+            if (str) {
                 strncpy(hostapd_dir_glob, str, HOSTAPD_DIR_LEN);
-
-            return true;
+                return true;
+            }
         }
     }
 
